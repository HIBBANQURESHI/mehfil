{
  "name": "mehfil",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "postinstall": "npm run build -w @mehfil/shared",
    "dev:db": "npm run db:embedded -w @mehfil/api",
    "dev:api": "npm run start:dev -w @mehfil/api",
    "dev:web": "npm run dev -w @mehfil/web",
    "dev:mobile": "npm run start -w @mehfil/mobile",
    "build": "npm run build -w @mehfil/shared && npm run build -w @mehfil/api && npm run build -w @mehfil/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @mehfil/shared && npm run test:e2e -w @mehfil/api"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-svg": "15.16.0"
  },
  "dependencies": {
    "otplib": "^12.0.1",
    "playwright-core": "^1.65.0"
  }
}
