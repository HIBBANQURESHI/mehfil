NODE_ENV=production
POSTGRES_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32 (back this up: losing it makes stored IBANs and 2FA secrets unreadable)
ENCRYPTION_KEY=
# openssl rand -base64 48 (shared by web and api)
INTERNAL_API_KEY=

WEB_URL=https://mehfil.example
API_PUBLIC_URL=https://api.mehfil.example
LEGAL_NAME=
SUPPORT_EMAIL=

# http works with most Pakistani gateways. Template placeholders: {to} {message} {sender} {key}
# Or textbee with TEXTBEE_API_KEY, for a small pilot using an Android phone's SIM.
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_API_KEY=
SMS_SENDER=
# Text in the gateway's reply that confirms the message was accepted
SMS_HTTP_SUCCESS_TEXT=

RESEND_API_KEY=
MAIL_FROM=Mehfil <no-reply@mehfil.example>

# Stays "none" until a gateway adapter is added. See docs/LAUNCH.md.
PAYMENT_PROVIDER=safepay
# Safepay: sandbox keys take test cards only. Switch SAFEPAY_ENV to production with live keys at launch.
SAFEPAY_ENV=production
SAFEPAY_API_KEY=sec_your-live-public-key
SAFEPAY_SECRET_KEY=your-live-secret-key
# Safepay dashboard > Developers > Endpoints > View shared secret (after adding the webhook URL).
SAFEPAY_WEBHOOK_SECRET=your-webhook-shared-secret

STORAGE_DRIVER=local

# Optional. Personalises new wedding plans in the background. Without it, plans still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
