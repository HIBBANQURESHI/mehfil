NODE_ENV=production
POSTGRES_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32 (back this up: losing it makes stored IBANs and 2FA secrets unreadable)
ENCRYPTION_KEY=
# openssl rand -base64 48 (shared by web and api)
INTERNAL_API_KEY=

WEB_URL=https://mehfil.example
API_PUBLIC_URL=https://api.mehfil.example
LEGAL_NAME=
SUPPORT_EMAIL=

# http works with most Pakistani gateways. Template placeholders: {to} {message} {sender} {key}
# Or textbee with TEXTBEE_API_KEY, for a small pilot using an Android phone's SIM.
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_API_KEY=
SMS_SENDER=
# Text in the gateway's reply that confirms the message was accepted
SMS_HTTP_SUCCESS_TEXT=

RESEND_API_KEY=
MAIL_FROM=Mehfil <no-reply@mehfil.example>

# Stays "none" until a gateway adapter is added. See docs/LAUNCH.md.
PAYMENT_PROVIDER=none

STORAGE_DRIVER=local
