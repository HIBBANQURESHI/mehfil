NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mehfil:mehfil@localhost:5433/mehfil

# openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
# openssl rand -base64 32
ENCRYPTION_KEY=

WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Comma separated extra origins. The mobile app does not use CORS.
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
# Lets the web server's page rendering skip rate limits. Set the same value in the web app.
INTERNAL_API_KEY=

# console prints codes to the log (refused in production). http is for local gateways. twilio also works.
SMS_PROVIDER=console
TEXTBEE_API_KEY=
SMS_HTTP_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_HTTP_SUCCESS_TEXT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email: one of these two is required in production
RESEND_API_KEY=
# smtp://user:pass@host:587
SMTP_URL=
MAIL_FROM=Mehfil <no-reply@example.com>

# none = checkout refused until a gateway is integrated. sandbox = fake payments (refused in production).
# sandbox = fake gateway for offline work; safepay = real Safepay (sandbox or live keys)
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=local-sandbox-secret
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# local or s3 (S3-compatible: AWS, Cloudflare R2, etc.)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
PUBLIC_FILES_URL=

JOBS_ENABLED=true

# Optional. Personalises new wedding plans in the background. Without it, plans still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
