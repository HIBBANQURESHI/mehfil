{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "outDir": "dist", "rootDir": ".", "sourceMap": true,
    "strict": true, "strictPropertyInitialization": false, "esModuleInterop": true, "skipLibCheck": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "resolveJsonModule": true, "incremental": false, "types": ["node", "jest", "multer"]
  },
  "include": ["src", "scripts", "test"]
}
