{
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e\\.ts$",
  "moduleFileExtensions": [
    "ts",
    "js",
    "json"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "diagnostics": false,
        "isolatedModules": true
      }
    ],
    "^.+.ts$": [
      "ts-jest",
      {
        "diagnostics": false,
        "tsconfig": {
          "isolatedModules": true,
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true,
          "esModuleInterop": true,
          "target": "ES2022",
          "module": "CommonJS"
        }
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/test/env.ts"
  ],
  "testTimeout": 120000,
  "forceExit": true
}